# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Logs & Temporary files
*.log
*.tmp

# AI / ML Model Checkpoints
# Ignore all new/temporary checkpoints generated during training,
# but explicitly track the 2 pre-trained best models for Linear & MLP:
checkpoints/*
!checkpoints/best_bird_linear.json
!checkpoints/best_bird_mlp.json
!checkpoints/.gitkeep

# Ignore common large weight formats if created
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
